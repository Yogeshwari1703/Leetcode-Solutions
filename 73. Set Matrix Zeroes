

class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int n = matrix.size();
        if (n == 0) return;
        int m = matrix[0].size();

        int col0 = 1;

        // Step 1: Use first row and first column as markers
        for (int i = 0; i < n; i++) {
            if (matrix[i][0] == 0) col0 = 0; // Mark if first column has zero
            for (int j = 1; j < m; j++) {
                if (matrix[i][j] == 0) {
                    matrix[i][0] = 0;   // Mark row
                    matrix[0][j] = 0;   // Mark column
                }
            }
        }

        // Step 2: Set zeroes based on markers, traversing from bottom-right to avoid overwriting markers early
        for (int i = n - 1; i >= 0; i--) {
            for (int j = m - 1; j >= 1; j--) {
                if (matrix[i][0] == 0 || matrix[0][j] == 0) {
                    matrix[i][j] = 0;
                }
            }
            // Finally, handle the first column for this row
            if (col0 == 0) {
                matrix[i][0] = 0;
            }
        }
    }
};
