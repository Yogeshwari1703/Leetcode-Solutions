class Solution {
public:
    int longestConsecutive(vector<int>& arr) {
     int n=arr.size();
    if(n==0) return 0;
    unordered_set<int>s(arr.begin(),arr.end());
    int max_length=1;
    
    for(auto it :s){
        if(s.find(it-1)==s.end()){
            int cnt=1;
            int x=it;
            while(s.find(x+1)!=s.end()){
                x++;
                cnt++;
            }
            max_length=max(max_length,cnt);
        }
    }
    return max_length;
    }
};
