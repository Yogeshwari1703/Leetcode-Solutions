#include <vector>
using namespace std;

class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        vector<int> pos;
        vector<int> neg;
        
        // Segregate the array into positives and negatives
        for(int i = 0; i < n; i++){
            if(nums[i] > 0) pos.push_back(nums[i]);
            else neg.push_back(nums[i]);
        }
        
        // Place positives on even indices, negatives on odd
        vector<int> result(n);
        for(int i = 0; i < n / 2; i++){
            result[2*i] = pos[i];
            result[2*i + 1] = neg[i];
        }
        
        return result;
    }
};
