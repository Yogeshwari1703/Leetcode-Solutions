
#include<iostream>
using namespace std;

class Solution{
public:
int majorityElement(vector<int>& arr){
    int ele;
    int cnt=0;
    int n=arr.size();
    for(int i=0;i<n;i++){
        if(cnt==0){
            ele=arr[i];
        }
        if(ele==arr[i]){
            cnt++;
        }else{
            cnt=cnt-1;
        }
    }
    int cnt1=0;
    for(int i=0;i<n;i++){
        if(arr[i]==ele){
            cnt1++;
        }
    }
    if(cnt1>n/2){
        return ele;
    }else
    return -1;
}
};
